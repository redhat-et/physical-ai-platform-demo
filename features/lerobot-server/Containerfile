FROM docker.io/nvidia/cuda:12.2.2-cudnn8-runtime-ubuntu22.04

COPY --from=ghcr.io/astral-sh/uv:0.5.1 /uv /uvx /bin/

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        git \
        git-lfs \
        build-essential \
        clang \
        ca-certificates && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

ENV UV_LINK_MODE=copy
ENV UV_PROJECT_ENVIRONMENT=/.venv

RUN uv python install 3.12 && \
    uv venv --python 3.12 ${UV_PROJECT_ENVIRONMENT}

# Install LeRobot
RUN git clone --depth 1 \
    https://github.com/huggingface/lerobot.git \
    /opt/lerobot

RUN cd /opt/lerobot && \
    uv pip install \
      --python ${UV_PROJECT_ENVIRONMENT}/bin/python \
      -e ".[pi]"

# Install ONLY the OpenPI client protocol package.
# Full OpenPI is intentionally not installed.
RUN uv pip install \
    --python ${UV_PROJECT_ENVIRONMENT}/bin/python \
    "openpi-client @ git+https://github.com/Physical-Intelligence/openpi.git#subdirectory=packages/openpi-client"

COPY serve_policy.py /app/serve_policy.py
COPY websocket_policy_server.py /app/websocket_policy_server.py

EXPOSE 8000

ENTRYPOINT ["/.venv/bin/python", "/app/serve_policy.py"]

CMD ["--checkpoint", "/mnt/models"]
